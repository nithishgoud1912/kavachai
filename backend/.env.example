# KavachAI Backend Environment Configuration
# Copy this to .env and fill in values

# --- Ollama ---
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen2.5:3b
VISION_MODEL=qwen2.5-vl:3b
EMBEDDING_MODEL=nomic-embed-text

# --- Server ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# --- Database ---
SQLITE_DB_PATH=./data/kavachai.db
CHROMA_DB_PATH=./data/chroma
OBJECT_STORE_PATH=./data/objects

# --- Ingestion ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64
EMBEDDING_DIMENSION=768

# --- Performance ---
LLM_TIMEOUT_SECONDS=60
AGENT_TIMEOUT_SECONDS=30

# --- Local authentication and RBAC ---
# Set ENVIRONMENT=production and disable demo sessions for every real deployment.
ENVIRONMENT=production
ALLOW_DEMO_SESSIONS=false
# Set a long random value out-of-band before the first production bootstrap.
BOOTSTRAP_TOKEN=
SESSION_MAX_HOURS=8
