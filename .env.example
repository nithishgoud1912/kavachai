# ─── KavachAI Docker Compose Environment Configuration ─────────────────
# Copy this file to .env to customize your deployment.

# Ollama Host Configuration:
# - Default (internal compose service): http://ollama:11434
# - To use an Ollama instance already running on your host machine: http://host.docker.internal:11434
OLLAMA_HOST=http://ollama:11434

# Models
LLM_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
